# Optional. Without it, extraction uses local OCR and llm_judgment rules use the
# offline keyword judge (same quote guard, same routing).
ANTHROPIC_API_KEY=
CLEARANCE_MODEL=claude-opus-5-5
# "ocr" (default, local) or "claude" (Claude reads the page images; needs the key above)
CLEARANCE_EXTRACTOR=ocr

# Optional. Stedi *test* key only. Without it, eligibility uses recorded X12 271 fixtures.
STEDI_API_KEY=

# NPPES NPI Registry is free and keyless. Set to 0 to stay fully offline.
CLEARANCE_NPPES_LIVE=1
